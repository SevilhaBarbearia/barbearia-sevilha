# Supabase - use as chaves públicas no frontend. Nunca exponha a service role key.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima

# URL pública da aplicação, usada no callback OAuth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Global Config da Vercel usado no rollout da nova UI.
# Em produção/preview, conecte o Global Config ao projeto pela Vercel.
# Em desenvolvimento local, deixe vazio ou use `vercel env pull`.
EDGE_CONFIG=

# Override SOMENTE para desenvolvimento local.
# Exemplos: "slug-do-tenant" ou "tenant-a,tenant-b".
# Use "*" apenas se quiser visualizar a nova UI para todos os tenants localmente.
UI_ROLLOUT_LOCAL_TENANTS=

# RESEND_API_KEY, EMAIL_FROM e APP_BASE_URL são secrets da Edge Function.
# Eu não os coloco no ambiente do navegador nem neste arquivo público.