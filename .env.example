# Supabase - somente chaves públicas no frontend.
# Nunca exponha a service role key em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima

# URL pública da aplicação, usada no callback OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rollback emergencial da interface.
# O Warm Premium é o padrão. Deixe false ou remova a variável normalmente.
# Use true apenas para um rollback temporário seguido de novo deploy.
UI_FORCE_LEGACY=false

# RESEND_API_KEY, EMAIL_FROM e APP_BASE_URL são secrets da Edge Function.
# Eles ficam no Supabase e nunca devem ser expostos ao navegador.
